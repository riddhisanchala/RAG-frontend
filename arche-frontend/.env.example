# Arche frontend — environment variables (Vite)
# Only variables starting with VITE_ are visible to the browser. NEVER put secrets here.
# They are baked in at BUILD time: on Vercel, redeploy after changing them.

# REQUIRED in production. Your Render backend URL, INCLUDING the /api suffix, no trailing slash.
# e.g. https://arche-backend.onrender.com/api
# Local development default: http://localhost:5000/api
VITE_API_URL=
